# URL del backend (Spring Boot).
# Déjala vacía en desarrollo: Vite reenvía las peticiones al backend (ver vite.config.js).
# En producción, escribe la dirección completa, por ejemplo: https://api.autosmart.pe
VITE_API_URL=

# true  = el panel usa datos de prueba (sirve para una demo sin backend ni base de datos)
# false = el panel usa el backend real (recomendado)
VITE_DATOS_PRUEBA=false
