    {
      "name": "3. Admin – Usuarios",
      "item": [
        {
          "name": "Listar clientes (HU-16)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users?rol=CLIENTE&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "rol",
                  "value": "CLIENTE"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "const lista = Array.isArray(datos) ? datos : (datos.contenido ?? datos.content);",
                  "pm.test(\"Devuelve una lista\", () => pm.expect(lista).to.be.an(\"array\"));",
                  "pm.test(\"Todos son CLIENTE\", () => lista.forEach(u => {",
                  "  const rol = typeof u.rol === \"object\" ? u.rol.nombre : u.rol;",
                  "  pm.expect(String(rol).toUpperCase()).to.include(\"CLIENTE\");",
                  "}));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar el cliente de prueba (HU-16)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users?q={{correoCliente}}&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{correoCliente}}"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "const lista = Array.isArray(datos) ? datos : (datos.contenido ?? datos.content);",
                  "const cliente = lista.find(u => u.correo === pm.collectionVariables.get(\"correoCliente\"));",
                  "pm.test(\"Encuentra al cliente registrado\", () => pm.expect(cliente).to.exist);",
                  "pm.collectionVariables.set(\"idCliente\", cliente.id ?? cliente.idUsuario);"
                ]
              }
            }
          ]
        },
