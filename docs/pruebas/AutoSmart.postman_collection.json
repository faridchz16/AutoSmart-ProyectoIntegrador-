            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente de Prueba\",\n  \"correo\": \"{{correoCliente}}\",\n  \"password\": \"{{passwordCliente}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
